{
  "name": "jarvis-app",
  "version": "1.12.0",
  "description": "JARVIS — a self-hosted AI workspace and agent harness.",
  "//build.files": "build.files uses *.js rather than naming main.js and preload.js individually. It is an ALLOWLIST, so a new main-process module is silently omitted from the package: electron/browser.js was, and 1.9.0 shipped an app whose main process died on require() before starting the backend, so it never opened at all. The glob means the next module added here is packaged automatically. Verify with scripts/verify-packaged-app.cjs, which checks main.js's relative requires against the real asar and then launches the packaged app. This note lives at the top level because electron-builder rejects unknown keys inside build.",
  "//productName": "Top-level (not just under build) on purpose: Electron's app.getName() prefers productName over name, and that name decides app.getPath('userData') — i.e. where every user's data lives. Without this it resolved to %APPDATA%\\jarvis-app. Changing it after release would silently orphan existing installs' data, so it has to be right before the first public build.",
  "productName": "JARVIS",
  "main": "main.js",
  "author": "David Darr",
  "license": "MIT",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "build-runtime": "python ../scripts/build_runtime.py",
    "predist": "npm run build-runtime",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "43.7.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.davidmichael.jarvis",
    "productName": "JARVIS",
    "copyright": "Copyright © 2026 David Darr",
    "directories": {
      "output": "../dist",
      "buildResources": "."
    },
    "files": [
      "*.js",
      "icon.png",
      "icon.ico",
      "node_modules/**/*",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "backend",
        "filter": [
          "**/*",
          "!electron/**",
          "!.venv/**",
          "!data/**",
          "!dist/**",
          "!.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.log",
          "!.env",
          "!.env.*",
          "!scripts/*.crt",
          "!scripts/*.key",
          "!scripts/*.pem"
        ]
      },
      {
        "from": "runtime",
        "to": "backend/runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "david-darr",
        "repo": "jarvis-app"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "JARVIS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "artifactName": "JARVIS-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "icon.png"
    },
    "afterPack": "afterPack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
